# ========================================================
# ZOVO Platform - Global Environment Configuration (.env.example)
# Copy this file to .env before deploying or running services.
# NEVER commit .env to version control!
# ========================================================

# --------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------
# For local SQLite testing (default out-of-the-box):
# DATABASE_URL=sqlite+aiosqlite:///./zovo.db
#
# For Docker Compose / Local PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/zovo_db
#
# For Supabase / Managed Cloud PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres.projectref:password@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/zovo_db

# --------------------------------------------------------
# 2. Security & Authentication
# --------------------------------------------------------
SECRET_KEY=change-this-to-a-strong-random-secret-key-in-production-min-32-chars
JWT_SECRET=change-this-to-a-strong-jwt-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Initial Admin Credentials (seeded automatically on startup)
ADMIN_EMAIL=admin@zovo.digital
ADMIN_INITIAL_PASSWORD=ZovoAdmin2026!Secure

# --------------------------------------------------------
# 3. Email Notification Configuration
# --------------------------------------------------------
# Options: "auto", "resend", "smtp", "console"
EMAIL_PROVIDER=console
EMAIL_FROM=ZOVO <notifications@zovo.digital>

# If using Resend (Recommended for cloud deployment):
RESEND_API_KEY=re_your_api_key_here

# If using SMTP (Gmail, SendGrid, Amazon SES):
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=your_smtp_password_here

# --------------------------------------------------------
# 4. Frontend & Public Site Variables
# --------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=+919876543210
NEXT_PUBLIC_COMPANY_EMAIL=hello@zovo.digital

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=
